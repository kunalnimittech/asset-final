PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Generate with: npx @better-auth/cli secret   (or any random 32+ char string)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection string. Use sslmode=verify-full for hosted databases.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?sslmode=verify-full

# ---- Single sign-on (optional) ----
# A provider's button is enabled once both its ID and secret are set.
# Redirect / callback URL to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/microsoft
#   {BETTER_AUTH_URL}/api/auth/callback/zoho

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra admin center -> App registrations -> New registration (Web platform)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" for any Microsoft account, or your Directory (tenant) ID to allow only NimitTech accounts
MICROSOFT_TENANT_ID=common

# Zoho API Console (https://api-console.zoho.com) -> Server-based Applications
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Your Zoho data centre: https://accounts.zoho.com, https://accounts.zoho.in, https://accounts.zoho.eu ...
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
